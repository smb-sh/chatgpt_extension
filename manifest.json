{
    "manifest_version": 3,
    "name": "Cookie Share Extension",
    "version": "1.0",
    "description": "Sends cookies from a specific domain to a server using a user token.",
    "permissions": [
      "cookies",
      "storage", 
      "tabs",
      "alarms" 
    ],
    "host_permissions": [
      "http://*/",
      "https://*/"
    ],
    "background": {
      "service_worker": "background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["content.js"]
      }
    ],
    "action": {
      "default_popup": "popup.html"
    }
}
  